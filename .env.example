# Copy to .env in this configuration directory. Keep credential values out of version control.
STATEWEAVER_TEXT_API_KEY=
STATEWEAVER_IMAGE_API_KEY=
STATEWEAVER_VIDEO_API_KEY=
STATEWEAVER_CUSTOM_VIDEO_API_KEY=

# Maximum retries after the first attempt, initial and maximum backoff in seconds.
# AGENTVIDEO_STUDIO_TEXT_RETRY__MAX_RETRIES=3
# AGENTVIDEO_STUDIO_TEXT_RETRY__BASE_DELAY_SECONDS=10
# AGENTVIDEO_STUDIO_TEXT_RETRY__MAX_DELAY_SECONDS=60
# AGENTVIDEO_STUDIO_IMAGE_RETRY__MAX_RETRIES=3
# AGENTVIDEO_STUDIO_IMAGE_RETRY__BASE_DELAY_SECONDS=60
# AGENTVIDEO_STUDIO_IMAGE_RETRY__MAX_DELAY_SECONDS=300
# AGENTVIDEO_STUDIO_VIDEO_RETRY__MAX_RETRIES=3
# AGENTVIDEO_STUDIO_VIDEO_RETRY__BASE_DELAY_SECONDS=60
# AGENTVIDEO_STUDIO_VIDEO_RETRY__MAX_DELAY_SECONDS=300

# Same-origin proxy target for the local web dev server. Credentials stay in the API process.
# VITE_API_PROXY_TARGET=http://127.0.0.1:8186
