{
  "name": "@stateweaver/web",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.15.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5276 --strictPort",
    "build": "uv run --project ../.. python ../../scripts/generate_studio_types.py --check && tsc -b && vite build",
    "generate:studio-types": "uv run --project ../.. python ../../scripts/generate_studio_types.py",
    "check:studio-types": "uv run --project ../.. python ../../scripts/generate_studio_types.py --check",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.2.8",
    "@fontsource/noto-sans-sc": "5.2.8",
    "@xyflow/react": "^12.8.5",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "openapi-typescript": "7.13.0",
    "typescript": "~5.7.2",
    "vite": "^5.4.14",
    "vitest": "^2.1.8"
  }
}
